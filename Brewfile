# Installed by scripts/03-packages.sh (brew bundle).
# The compiler, clangd, lldb and git come from Apple's Command Line Tools.

brew "cmake"         # build system generator
brew "ninja"         # fast build backend for CMake
brew "clang-format"  # formatter; reads each repo's .clang-format
brew "tmux"
brew "ripgrep"       # rg: code search, also vim's :grep
brew "fzf"           # fuzzy finder: vim <Space>p, shell Ctrl-R / Ctrl-T

cask "iterm2"
